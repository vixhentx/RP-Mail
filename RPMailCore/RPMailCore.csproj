<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <Company>RobotPilots Software Research &amp; Development Department</Company>
        <SignAssembly>true</SignAssembly>
        <AssemblyVersion>0.9.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" Version="33.1.0" />
      <PackageReference Include="MailKit" Version="4.17.0" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
      <PackageReference Include="R3" Version="1.3.1" />
      <PackageReference Include="Scriban" Version="7.2.6" />
      <PackageReference Include="Typst.Native" Version="0.15.0" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources/Strings.resx">
        <Generator>MSBuild:Compile</Generator>
        <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
        <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
        <StronglyTypedNamespace>RPMailCore.Resources</StronglyTypedNamespace>
        <StronglyTypedClassName>Strings</StronglyTypedClassName>
        <PublicClass>true</PublicClass>
      </EmbeddedResource>
    </ItemGroup>

</Project>
