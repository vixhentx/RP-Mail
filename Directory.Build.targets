<Project>

  <!--
    The strongly-typed resource classes (Strings.g.cs) are generated by the
    GenerateResource task as part of the "PrepareResources" target, which is
    only wired into the "CoreBuild" dependency chain.

    IDE design-time builds (Roslyn / C# Dev Kit) invoke only the "Compile"
    target with DesignTimeBuild=true, which does NOT run PrepareResources.
    As a result the generated Strings.g.cs is neither produced nor added to
    @(Compile), and the IDE reports "the name 'Strings' does not exist".

    This target forces PrepareResources to run before CoreCompile during
    design-time builds so the strongly-typed resource file is generated and
    included in the compilation, matching what a real terminal build does.
  -->
  <Target Name="GenerateStronglyTypedResourcesForDesignTimeBuild"
          BeforeTargets="CoreCompile"
          DependsOnTargets="PrepareResources"
          Condition="'$(DesignTimeBuild)' == 'true'" />

</Project>
