<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:contracts="using:RPMailUI.Contracts.ViewModels"
        xmlns:design="using:RPMailUI.Design.ViewModels"
        xmlns:res="using:RPMailUI.Resources"
        xmlns:views="using:RPMailUI.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="RPMailUI.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="contracts:IMainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="RP-Mail UI"
        MinHeight="500" MinWidth="520"
        >
    <Design.DataContext>
        <design:DesignMainWindowViewModel/>
    </Design.DataContext>

    <DockPanel x:Name="LayoutRoot">
        <Border DockPanel.Dock="Top" Classes="top-bar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Classes="app-title" Text="RP-Mail"/>
                    <TextBlock Classes="app-version" Text="UI"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="subtle-button" Content="{x:Static res:Strings.OpenOutput}" IsVisible="{CompiledBinding Run.ShouldOpenOutputFolder.Value}" Command="{CompiledBinding Run.OpenOutputFolderCommand}"/>
                    <Button Classes="subtle-button" Content="{x:Static res:Strings.Retry}" IsVisible="{CompiledBinding Run.ShouldRetry.Value}" Command="{CompiledBinding Run.RetryCommand}"/>
                    <Button Classes="cancel-button" Content="{x:Static res:Strings.Cancel}" IsVisible="{CompiledBinding Run.ShouldCancel.Value}" Command="{CompiledBinding Run.CancelCommand}"/>
                    <Button Classes="primary-action" Content="{x:Static res:Strings.Start}" IsVisible="{CompiledBinding Run.ShouldStart.Value}" Command="{CompiledBinding Run.StartCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="workspace-bar">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Classes="field-label" VerticalAlignment="Center" Text="{x:Static res:Strings.WorkspaceDirectory}"/>
                <TextBox Grid.Column="1" Text="{CompiledBinding Workspace.WorkspaceDirectory.Value, Mode=TwoWay}"/>
                <Button Grid.Column="2" Classes="subtle-button" Content="{x:Static res:Strings.Browse}" Command="{CompiledBinding Workspace.BrowseWorkspaceCommand}"/>
                <Button Grid.Column="3" Classes="subtle-button" Content="{x:Static res:Strings.Import}" Command="{CompiledBinding Workspace.ImportMailConfigCommand}"/>
                <Button Grid.Column="4" Classes="subtle-button" Content="{x:Static res:Strings.Export}" Command="{CompiledBinding Workspace.ExportMailConfigCommand}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="status-bar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Classes="muted-text" Text="{CompiledBinding Run.StateText.Value}"/>
                <TextBlock Grid.Column="1" Classes="muted-text" Text="{x:Static res:Strings.Total}"/>
                <TextBlock Grid.Column="2" Classes="status-number" Text="{CompiledBinding Run.TaskList.TotalCount.Value}"/>
                <TextBlock Grid.Column="3" Classes="muted-text" Text="{CompiledBinding Run.ProgressText.Value}"/>
            </Grid>
        </Border>

        <Border x:Name="RunHost" DockPanel.Dock="Right" Classes="run-panel">
            <views:RunPanelView DataContext="{CompiledBinding Run}"/>
        </Border>

		<!-- 主要编辑区 -->
        <Border x:Name="EditorHost" Classes="editor-panel">
            <TabbedPage TabPlacement="Left" Classes="navi-page">
				<ContentPage Header="{x:Static res:Strings.ContentSettings}">
					<views:ContentSettingsView DataContext="{CompiledBinding Content}"/>
				</ContentPage>
				<ContentPage Header="{x:Static res:Strings.SenderSettings}">
					<views:SenderSettingsView DataContext="{CompiledBinding Sender}"/>
				</ContentPage>
				<ContentPage Header="{x:Static res:Strings.ConvertSettings}">
					<views:ConvertSettingsView DataContext="{CompiledBinding Convert}"/>
				</ContentPage>
			</TabbedPage>
        </Border>

    </DockPanel>
</Window>
