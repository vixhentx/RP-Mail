<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:converter="clr-namespace:RPMailUI.Converter"
                xmlns:model="clr-namespace:RPMailUI.Models"
                xmlns:res="using:RPMailUI.Resources"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                x:Class="RPMailUI.Controls.TaskListView"
                x:Name="Root">
    <Design.Width>400</Design.Width>
    <Design.Height>600</Design.Height>
    <UserControl.Resources>
        <converter:DictionaryValueConverter x:Key="DictionaryValueConverter"/>
        <converter:ResourceColorConverter x:Key="ResourceColorConverter"/>
    </UserControl.Resources>
        <ScrollViewer>
            <DockPanel>
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="Auto,Auto,Auto,*">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Static res:Strings.PropertyShown}"/>
                    <ComboBox Grid.Column="1" x:Name="PropertyComboBox" HorizontalAlignment="Stretch" Margin="5"
                              ItemsSource="{Binding #Root.AvailableHeaders.Value}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Static res:Strings.Search}"/>
                    <TextBox Grid.Column="3" Text="{Binding #Root.SearchText}" HorizontalAlignment="Stretch" Margin="5"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding #Root.TasksView.Value}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:TaskItemData">
                            <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    CornerRadius="5" BorderThickness="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Status, Converter={StaticResource ResourceColorConverter}}"/>
                                </Border.Background>
                                <DockPanel>
                                    <SelectableTextBlock DockPanel.Dock="Right" Margin="5"
                                                         FontSize="14" Text="{Binding Tooltip}"/>
                                    <SelectableTextBlock FontSize="14" Margin="5">
                                        <SelectableTextBlock.Text>
                                            <MultiBinding Converter="{StaticResource DictionaryValueConverter}">
                                                <Binding Path="Data"/>
                                                <Binding Path="#PropertyComboBox.SelectedItem"/>
                                            </MultiBinding>
                                        </SelectableTextBlock.Text>
                                    </SelectableTextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </ScrollViewer>
</UserControl>
