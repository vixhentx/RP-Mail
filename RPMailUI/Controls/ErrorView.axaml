<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RPMailUI.Models"
             xmlns:converter="clr-namespace:RPMailUI.Converter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RPMailUI.Controls.ErrorView"
             x:Name="Root">
    <UserControl.Resources>
        <converter:ResourceColorConverter x:Key="ResourceColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer HorizontalAlignment="Stretch" x:Name="ScrollView">
            <ItemsControl x:Name="ErrorsControl">
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="models:ErrorItemData">
                        <Border x:Name="BorderFrame"
                                BorderBrush="White"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding BackgroundKey, Converter={StaticResource ResourceColorConverter}}"/>
                            </Border.Background>
                            <DockPanel>
                                <SelectableTextBlock Text="{Binding Message}" Height="{Binding #Root.CellHeight}" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="5"
                                           TextWrapping="Wrap" TextAlignment="Center">
                                    <SelectableTextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding ForegroundKey, Converter={StaticResource ResourceColorConverter}}"/>
                                    </SelectableTextBlock.Foreground>
                                </SelectableTextBlock>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>
</UserControl>
