<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource RpWindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
    </Style>

    <Style Selector="Border.top-bar">
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,12" />
    </Style>

    <Style Selector="Border.workspace-bar">
        <Setter Property="Background" Value="{DynamicResource RpSubtleBrush}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style Selector="Border.navigation-panel">
        <Setter Property="Background" Value="{DynamicResource RpSubtleBrush}" />
        <Setter Property="Padding" Value="14,18" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.editor-panel">
        <Setter Property="Background" Value="{DynamicResource RpWindowBrush}" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <Style Selector="Border.run-panel">
        <Setter Property="Background" Value="{DynamicResource RpSubtleBrush}" />
        <Setter Property="Padding" Value="14,16" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="TextBlock.app-title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.app-version">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.nav-caption">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,0,4,8" />
    </Style>

    <Style Selector="Button.nav-item">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="MinHeight" Value="58" />
    </Style>

    <Style Selector="TextBlock.nav-item-title">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.nav-item-summary">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.settings-card">
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="DockPanel.section-heading">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="ScrollViewer.editor-scroll">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style Selector="Button.subtle-button">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="Button.cancel-button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
    </Style>

    <Style Selector="Border.run-summary">
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="TextBlock.run-state">
        <Setter Property="Foreground" Value="{DynamicResource RpRunningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.metric-card">
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="TextBlock.metric-value">
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.metric-label">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.muted-text">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.status-number">
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.success-text">
        <Setter Property="Foreground" Value="{DynamicResource RpSuccessBrush}" />
    </Style>

    <Style Selector="TextBlock.error-text">
        <Setter Property="Foreground" Value="{DynamicResource RpErrorBrush}" />
    </Style>

    <Style Selector="TabControl.run-tabs">
        <Setter Property="MinHeight" Value="160" />
    </Style>

    <Style Selector="TextBox.console-output">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="Border.error-panel">
        <Setter Property="MaxHeight" Value="120" />
        <Setter Property="Background" Value="{DynamicResource RpPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Label.field-label">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource RpControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource RpControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
    </Style>

    <Style Selector="Button.toolbar-button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource RpAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RpAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.86" />
    </Style>

    <Style Selector="Expander.section-expander">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabItem.workspace-tab">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="ProgressBar.run-progress">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="8,4,8,8" />
    </Style>

    <Style Selector="Border.task-item">
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector="Border.error-item">
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4,3" />
    </Style>

    <Style Selector="ScrollViewer.config-scroll">
        <Setter Property="Margin" Value="12" />
    </Style>

    <Style Selector="TabbedPage.navi-page TabControl TabItem TextBlock">
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabbedPage.navi-page, TabbedPage.navi-page ContentPage">
        <Setter Property="Background" Value="{DynamicResource RpSubtleBrush}" />
        <Setter Property="Padding" Value="14,18" />
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
</Styles>
