<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource RpWindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RpTextBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Label.field-label">
        <Setter Property="Foreground" Value="{DynamicResource RpMutedTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style Selector="Button.toolbar-button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Button.primary-action">
        <Setter Property="Background" Value="{DynamicResource RpAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
    </Style>

    <Style Selector="Button.primary-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.86" />
    </Style>

    <Style Selector="Expander.section-expander">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabItem.workspace-tab">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="ProgressBar.run-progress">
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="8,4,8,8" />
    </Style>

    <Style Selector="Border.task-item">
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style Selector="Border.error-item">
        <Setter Property="BorderBrush" Value="{DynamicResource RpBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4,3" />
    </Style>

    <Style Selector="ScrollViewer.config-scroll">
        <Setter Property="Margin" Value="12" />
    </Style>
</Styles>
